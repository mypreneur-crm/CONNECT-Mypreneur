{
  "name": "mypreneur-connect-deploy",
  "version": "5.0.0",
  "private": true,
  "description": "Mypreneur Connect using existing database users, roles, teams, and login history",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "check-db": "node --env-file=.env scripts/check-database.js",
    "test-login": "node --env-file=.env scripts/test-login.js",
    "add-user": "node --env-file=.env scripts/add-user.js",
    "sync-roles": "node --env-file=.env scripts/sync-roles.js",
    "test": "node tests/unit-test.js",
    "test:api": "node --env-file=.env tests/monthly-1on1-api-test.js",
    "test:frontend": "node tests/frontend-dashboard-test.js",
    "test:form": "node --env-file=.env tests/monthly-1on1-form-e2e-test.js",
    "test:manager": "node --env-file=.env tests/monthly-1on1-manager-review-test.js",
    "test:print": "node --env-file=.env tests/monthly-1on1-print-view-test.js",
    "test:security": "node --env-file=.env tests/security-verification-suite.js",
    "db:backup": "node --env-file=.env scripts/backup-database.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "mysql2": "3.23.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
