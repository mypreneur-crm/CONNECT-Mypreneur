# Copy this file to .env for LOCAL TESTING ONLY. Never commit .env to GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_TABLE_PREFIX=connect_
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_SSL=false

# Existing authentication tables managed by the senior's tool.
AUTH_USERS_TABLE=users
AUTH_EMPLOYEES_TABLE=employees
AUTH_USER_ROLES_TABLE=user_roles
AUTH_ROLES_TABLE=roles
AUTH_TEAMS_TABLE=teams

# Set true only while the existing tool still uses unsalted 64-character SHA-256 hashes.
# Production recommendation: migrate the existing tool to bcrypt, then set this to false.
ALLOW_LEGACY_SHA256_PASSWORDS=false

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false
DATA_DIR=./data
