# Database Configuration (PROD)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_TIMEZONE=+05:30

# Existing authentication tables
AUTH_USERS_TABLE=users
AUTH_EMPLOYEES_TABLE=employees
AUTH_USER_ROLES_TABLE=user_roles
AUTH_ROLES_TABLE=roles
AUTH_TEAMS_TABLE=teams
AUTH_LOGIN_HISTORY_TABLE=login_history

# Existing role names created by the database administrator
PORTAL_ADMIN_ROLES=ADMIN
PORTAL_SALES_ADMIN_ROLES=sales.admin
PORTAL_OPERATIONS_ADMIN_ROLES=operation.admin,operations.admin
PORTAL_HR_ADMIN_ROLES=hr.admin
PORTAL_DIGITAL_ADMIN_ROLES=digital.admin

# Existing team names used for normal member access
PORTAL_SALES_TEAMS=Sales
PORTAL_OPERATIONS_TEAMS=Operations
PORTAL_HR_TEAMS=HR
PORTAL_DIGITAL_TEAMS=Digital

# Current uploaded database stores 64-character SHA-256 password hashes.
# Disable this only after the existing authentication system migrates passwords.
ALLOW_LEGACY_SHA256_PASSWORDS=true

# Server Configuration
PORT=8000
NODE_ENV=production
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password
SMTP_FROM="Mypreneur CRM" <your_email@domain.com>

# Deployment Configuration
SSH_HOST=your_ssh_host
SSH_PORT=65002
SSH_USER=your_ssh_user
SSH_PASSWORD=your_ssh_password